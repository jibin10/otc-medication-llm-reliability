{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "products",
    "comparison"
  ],
  "properties": {
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "active_ingredient_names",
          "formulation",
          "product_ndc",
          "source_ndcs",
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "EXACT_NDC_IDENTIFIED",
              "FORMULATION_IDENTIFIED",
              "INGREDIENT_SET_IDENTIFIED",
              "INSUFFICIENT_INFORMATION",
              "NO_MATCH",
              "SOURCE_CONFLICT"
            ]
          },
          "product_ndc": {
            "type": [
              "string",
              "null"
            ]
          },
          "active_ingredient_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "source_ndcs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "formulation": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "active_ingredients",
                  "dosage_form",
                  "route"
                ],
                "properties": {
                  "active_ingredients": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "strength"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "strength": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "dosage_form": {
                    "type": "string"
                  },
                  "route": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "comparison": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ingredient_overlap",
            "same_active_ingredient_set",
            "shared_active_ingredient_names"
          ],
          "properties": {
            "ingredient_overlap": {
              "enum": [
                null,
                "shared",
                "disjoint"
              ]
            },
            "same_active_ingredient_set": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "shared_active_ingredient_names": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        }
      ]
    }
  },
  "description": "Structural schema plus the executable semantic checks in parse_output. Unknown names are scored as unsupported additions, never repaired using references."
}
